<?xml version="1.0" encoding="UTF-8"?>
<!-- Each type breaks one rule, or uses one construct the resolver does not support. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:i="urn:test:invalid" targetNamespace="urn:test:invalid">
  <xs:complexType name="Base">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="must" type="xs:string" use="required"/>
        <xs:attribute name="may" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="ExtensionRedeclares">
    <xs:simpleContent>
      <xs:extension base="i:Base">
        <xs:attribute name="may" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="ProhibitsRequired">
    <xs:simpleContent>
      <xs:restriction base="i:Base">
        <xs:attribute name="must" use="prohibited"/>
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="LoosensRequired">
    <xs:simpleContent>
      <xs:restriction base="i:Base">
        <xs:attribute name="must" type="xs:string" use="optional"/>
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="RestrictionAddsAttribute">
    <xs:simpleContent>
      <xs:restriction base="i:Base">
        <xs:attribute name="extra" type="xs:string"/>
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>

  <xs:simpleType name="Union">
    <xs:union memberTypes="xs:string xs:integer"/>
  </xs:simpleType>
  <xs:complexType name="UnmodelledBuiltin">
    <xs:sequence>
      <xs:element name="Period" type="xs:duration"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Head" type="xs:string" abstract="true"/>
  <xs:element name="Member" type="xs:string" substitutionGroup="i:Head"/>
  <xs:complexType name="UsesSubstitutionGroup">
    <xs:sequence>
      <xs:element ref="i:Head"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
